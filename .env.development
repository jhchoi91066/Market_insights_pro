# Development Environment Configuration
# Market Insights Pro

# Application Settings
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev_secret_key_not_for_production
API_VERSION=v1

# Database Configuration
DATABASE_URL=sqlite:///data/market_insights_dev.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_RETRY_ON_TIMEOUT=true

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=market_insights_dev
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=3000

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=Asia/Seoul
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=true
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# Monitoring & Logging
LOG_LEVEL=DEBUG
PROMETHEUS_ENABLED=true
METRICS_PORT=8001
HEALTH_CHECK_ENABLED=true

# Performance Settings
MAX_WORKERS=1
WORKER_TIMEOUT=60
KEEP_ALIVE=2
MAX_REQUESTS=0
MAX_REQUESTS_JITTER=0

# Security Settings
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_ENABLED=false
MAX_REQUESTS_PER_MINUTE=1000

# File Upload Settings
MAX_UPLOAD_SIZE=10MB
UPLOAD_DIR=./data/uploads

# Cache Settings
CACHE_TTL=300
CACHE_MAX_SIZE=100

# Naver API Configuration
NAVER_CLIENT_ID=jxsgVrDaxDtq0bZWATxe
NAVER_CLIENT_SECRET=HNeuJvoB5p

# Exchange Rate (KRW to USD)
EXCHANGE_RATE_KRW_USD=1350